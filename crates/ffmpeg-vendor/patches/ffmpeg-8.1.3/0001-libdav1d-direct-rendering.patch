+/* Gives the output frame its own references to the picture's buffers. */
+static int libdav1d_ref_picture_buffers(AVFrame *frame, const AVFrame *picture)
+{
+    for (int i = 0; i < FF_ARRAY_ELEMS(picture->buf); i++) {
+        if (!picture->buf[i])
+            continue;
+        frame->buf[i] = av_buffer_ref(picture->buf[i]);
+        if (!frame->buf[i])
+            return AVERROR(ENOMEM);
+    }
+    return 0;
 }
 
