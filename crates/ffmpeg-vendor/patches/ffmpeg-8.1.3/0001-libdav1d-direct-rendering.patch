+static int libdav1d_picture_allocator(Dav1dPicture *p, void *cookie)
+{
+    AVCodecContext *c = cookie;
+    Libdav1dContext *dav1d = c->priv_data;
+    enum AVPixelFormat format = pix_fmt[p->p.layout][p->seq_hdr->hbd];
+    int ret, h = FFALIGN(p->p.h, 128), w = FFALIGN(p->p.w, 128);
+    AVFrame *f = NULL;
+
+    // The default get_buffer2() keeps the internal pool: it is equivalent and
+    // already satisfies the libdav1d constraints.
+    if (c->get_buffer2 != avcodec_default_get_buffer2) {
+        ret = libdav1d_caller_frame(c, &f, format, w, h);
+        if (ret < 0)
+            return ret;
+    }
+    if (!f) {
+        ret = libdav1d_pool_frame(dav1d, &f, format, w, h);
+        if (ret < 0)
+            return ret;
+    }
+
+    p->data[0] = f->data[0];
+    p->data[1] = f->data[1];
+    p->data[2] = f->data[2];
+    p->stride[0] = f->linesize[0];
+    p->stride[1] = f->linesize[1];
+    p->allocator_data = f;
 
     return 0;
 }
 
