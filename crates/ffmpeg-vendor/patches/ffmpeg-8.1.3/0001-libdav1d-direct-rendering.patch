+/*
+ * get_buffer2() gives no guarantee that the returned picture meets the
+ * libdav1d allocator contract (see Dav1dPicAllocator): every plane pointer and
+ * stride aligned to DAV1D_PICTURE_ALIGNMENT, chroma planes sharing one stride,
+ * and DAV1D_PICTURE_ALIGNMENT bytes of padding after each 128-aligned plane.
+ * Check all of it before handing the memory to libdav1d.
+ */
+static int libdav1d_frame_meets_dav1d_constraints(const AVFrame *f,
+                                                  enum AVPixelFormat format,
+                                                  int w, int h)
+{
+    const AVPixFmtDescriptor *desc = av_pix_fmt_desc_get(format);
+    int planes = av_pix_fmt_count_planes(format);
+
+    if (!desc || planes <= 0 || planes > 3 || f->nb_extended_buf)
+        return 0;
+
+    for (int i = 0; i < planes; i++) {
+        int plane_h = i ? AV_CEIL_RSHIFT(h, desc->log2_chroma_h) : h;
+        // Check against the requested width, not f->width, which the callback could alter.
+        int min_linesize = av_image_get_linesize(format, w, i);
+
+        if (!f->data[i] || min_linesize <= 0 ||
+            f->linesize[i] < min_linesize ||
+            f->linesize[i] % DAV1D_PICTURE_ALIGNMENT ||
+            (uintptr_t)f->data[i] % DAV1D_PICTURE_ALIGNMENT)
+            return 0;
+        if (i == 2 && f->linesize[2] != f->linesize[1])
+            return 0;
+        if (!libdav1d_frame_buffer_holds(f, f->data[i],
+                                         (size_t)f->linesize[i] * plane_h +
+                                         DAV1D_PICTURE_ALIGNMENT))
+            return 0;
+    }
+    return 1;
+}
+
+/*
+ * Direct rendering: ask the caller's get_buffer2() for the picture memory.
+ * On success *out holds the frame, or stays NULL if the caller's picture does
+ * not meet the libdav1d constraints and the internal pool must be used.
+ */
+static int libdav1d_caller_frame(AVCodecContext *c, AVFrame **out,
+                                 enum AVPixelFormat format, int w, int h)
+{
+    Libdav1dContext *dav1d = c->priv_data;
+    AVFrame *f = av_frame_alloc();
+    int ret;
+
+    if (!f)
+        return AVERROR(ENOMEM);
+
+    f->format = format;
+    f->width  = w;
+    f->height = h;
+    ret = c->get_buffer2(c, f, AV_GET_BUFFER_FLAG_REF);
+    if (ret < 0) {
+        av_frame_free(&f);
+        return ret;
+    }
+
+    if (!libdav1d_frame_meets_dav1d_constraints(f, format, w, h)) {
+        if (!dav1d->warned_unusable_get_buffer) {
+            av_log(c, AV_LOG_WARNING, "get_buffer2() returned a picture that "
+                   "does not meet libdav1d alignment or padding requirements, "
+                   "falling back to the internal pool\n");
+            dav1d->warned_unusable_get_buffer = 1;
+        }
+        av_frame_free(&f);
+        return 0;
+    }
+
+    *out = f;
+    return 0;
+}
+
+static int libdav1d_pool_frame(Libdav1dContext *dav1d, AVFrame **out,
+                               enum AVPixelFormat format, int w, int h)
+{
+    int ret;
+    uint8_t *aligned_ptr;
     AVBufferRef *buf;
+    AVFrame *f;
 
