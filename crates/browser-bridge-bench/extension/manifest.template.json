{
  "manifest_version": 3,
  "name": "Fastiplayer bench stand interceptor (test-only)",
  "version": "0.0.1",
  "description": "TEST-ONLY: crude MSE interceptor of the browser-bridge test bench. Replaced by the real extension in session 09.",
  "key": "@MANIFEST_KEY@",
  "permissions": ["nativeMessaging"],
  "host_permissions": ["http://127.0.0.1/*", "http://localhost/*"],
  "background": {
    "service_worker": "background.js",
    "scripts": [
      "config.js",
      "lib/frame.js",
      "lib/base64.js",
      "lib/session-driver.js",
      "background.js"
    ]
  },
  "content_scripts": [
    {
      "matches": ["http://127.0.0.1/*", "http://localhost/*"],
      "all_frames": true,
      "run_at": "document_start",
      "world": "MAIN",
      "js": ["lib/activation.js", "lib/base64.js", "lib/generation-tracker.js", "page-hook.js"]
    },
    {
      "matches": ["http://127.0.0.1/*", "http://localhost/*"],
      "all_frames": true,
      "run_at": "document_start",
      "js": ["lib/activation.isolated.js", "content-bridge.js"]
    }
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'; connect-src 'self' ws://127.0.0.1:* http://127.0.0.1:* http://localhost:*"
  },
  "browser_specific_settings": { "gecko": { "id": "@GECKO_ID@" } }
}
