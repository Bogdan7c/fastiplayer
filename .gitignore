# Rust build output.
target/

# Coverage raw profiles, LCOV и HTML являются локальными/CI artifacts.
target/coverage/

# Local environment files.
.env
.env.*

# Editor and OS noise.
.idea/
.vscode/
*.swp
*~

# Runtime logs and temporary diagnostics.
*.log
*.tmp

# Python test/runtime bytecode is generated locally and must not enter Git.
__pycache__/
*.py[cod]


# Large local media fixtures must stay outside Git history.
test-assets/

# Личные пользовательские документы хранятся вне публичного репозитория.
/user/
