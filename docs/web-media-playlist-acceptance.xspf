    </track>
    <track>
      <location>https://archive.org/details/BigBuckBunny_328</location>
      <title>08 Progressive HTTP — ISO-BMFF MP4</title>
    </track>
    <track>
      <location>https://demo.unified-streaming.com/k8s/features/stable/video/tears-of-steel/tears-of-steel.ism/.f4m</location>
